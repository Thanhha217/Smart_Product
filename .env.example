# Copy to .env before the first `docker compose -f docker-compose.dev.yml up`:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# docker-compose.dev.yml reads this file (env_file: ${ENV_FILE_PATH:-.env}) and fails without it.

# Airflow (scrapers)
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.1
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow

# Optional: Fernet key that encrypts Airflow connections (blank = unencrypted, fine for dev).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
