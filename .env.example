# Copy to .env before the first `docker compose -f docker-compose.dev.yml up`:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# docker-compose.dev.yml reads this file (env_file: ${ENV_FILE_PATH:-.env}) and fails without it.

# Airflow (scrapers)
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.1
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow

# Optional: Fernet key that encrypts Airflow connections (blank = unencrypted, fine for dev).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# AI texts (AI result page, "ask anything" explanations). Optional: without a key the pages use
# rule-based texts filled with the real numbers. OpenAI is used first when both keys are set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# Public URL of the web app, used in links returned by the MCP server (ngrok/cloudflared URL when demoing in ChatGPT)
PUBLIC_WEB_URL=http://localhost:5173
MCP_RATE_LIMIT_PER_MIN=30
