KAFKA_SERVER_ADDRESS="kafka:9092"
SHOP_1_TOPIC_NAME="fpt_topic"
SHOP_2_TOPIC_NAME="tgdd_topic"
SHOP_3_TOPIC_NAME="phongvu_topic"
SHOP_4_TOPIC_NAME="dienmayxanh_topic"
SHOP_5_TOPIC_NAME="cellphone_s_topic"
POSTGRES_URL="postgresql://postgres:password@smart-product-finder-database/smart_product_finder"
FAISS_INDEX_PATH="/opt/faiss_index/products.faiss"
FAISS_IMAGE_INDEX_PATH="/opt/faiss_index/images.faiss"
OPEN_CLIP_PROVIDER_URL="http://smartproductfinder-backend-clip-provider:8067"
RANKING_SYSTEM_URL="http://smartproductfinder-ranking-system:8008"
DB_SEARCH_URL="http://smartproductfinder-db-search:8061"
OLLAMA_HOST="http://ollama:11434"
OLLAMA_KEEP_ALIVE="30m"
CO2E_LLM_PROVIDER="ollama"
CO2E_LLM_MODEL="qwen3.5:0.8b"
# Search result reasons by the local model: on a laptop CPU it times out (10 s) on every search, which
# made each /query take 10-17 s and the MCP tools time out. Off = the rule-based reasons, instant.
RANKING_LLM_EXPLANATIONS="0"
CO2E_FALLBACK="1"
# AI pages / test checkout (docs/demo/api-contract.md). ANTHROPIC_API_KEY is NOT stored here.
ASSISTANT_URL="http://smartproductfinder-assistant:8070"
ASSISTANT_MODEL="claude-opus-5-5"
ASSISTANT_TIMEOUT_S="20"
ASSISTANT_MAX_PRODUCTS="6"
CHECKOUT_MODE="test"
CO2E_SIM_THRESHOLD="0.66"
CO2_GRID_EF="0.681"
# Demo only: these five laptops have a hand-checked teardown, so the default search order
# opens on them (Acer first). Remove the line and search goes back to its normal order.
DEMO_PINNED_IDS="660,718,823,287,640"
